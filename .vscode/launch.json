{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask backend (:5000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app.py",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "FLASK_DEBUG": "1",
        "PORT": "5000",
        "CORS_ORIGINS": "*"
      }
    }
  ]
}
